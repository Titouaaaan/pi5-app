# Installed by deploy.sh --backend into /etc/systemd/system/.
# Edit it here, commit, and deploy; never edit the copy in /etc by hand.
[Unit]
Description=FastAPI backend for titouanguerin.com
After=network.target

[Service]
WorkingDirectory=/home/titouan/home/pi/pi5-app/backend
Environment=DEPLOY_INFO_PATH=/home/titouan/home/pi/pi5-app/.deploy/info.json
Environment=DATA_DIR=/home/titouan/home/pi/pi5-app/.data
# Secrets (CLOUDFLARE_API_TOKEN, optionally GITHUB_TOKEN). Root-owned, mode 600;
# systemd reads it before dropping to the service user. '-' makes it optional.
EnvironmentFile=-/etc/pi5-app/backend.env
# Localhost only: the tunnel, Next's /api rewrite and uptime-kuma all run on
# this machine, so the port has no business being reachable from the LAN.
ExecStart=/home/titouan/home/pi/pi5-app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
User=titouan
Group=titouan
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
